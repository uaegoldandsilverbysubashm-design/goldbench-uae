  else if(state==='break'){pill.classList.add('brk');pt.textContent='Daily Break';}
  else{pill.classList.add('closed');pt.textContent='Market Closed';}
  document.getElementById('mktClock').textContent=now.toLocaleString('en-GB',{weekday:'short',day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false,timeZone:selectedTz})+' · '+tzInfo.l;
  const brkBanner=document.getElementById('mktBreakBanner');
  if(brkBanner){
    document.getElementById('mktBreakWindow').textContent=utcHourToTzLabel(MKT_BREAK_START_H)+' – '+utcHourToTzLabel(MKT_BREAK_END_H)+' ('+tzInfo.l+')';
    document.getElementById('mktBreakLive').style.display=state==='break'?'inline':'none';
  }
  const thdTt=document.getElementById('thdTt'),sessTt=document.getElementById('sessTt');
  if(thdTt)thdTt.textContent='Indicative Trading Hours by Day ('+tzInfo.l+')';
  if(sessTt)sessTt.textContent='Trading Sessions ('+tzInfo.l+')';
