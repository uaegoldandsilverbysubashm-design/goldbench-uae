// ═══════════════════════════════════════════════════════════
// LIVE RATE CARD PDF  — today's gold rates for every karat
// (AED per gram / Pavan / Tola) plus a silver·platinum·palladium
// strip. Same lazy-jsPDF + offline print fallback as quotations.
// ═══════════════════════════════════════════════════════════
const RC_KARATS=[
  {k:'24K',p:'999 · 99.9%',f:1},{k:'22K',p:'916 · 91.6%',f:22/24},
  {k:'21K',p:'875 · 87.5%',f:21/24},{k:'18K',p:'750 · 75.0%',f:18/24},
  {k:'14K',p:'585 · 58.3%',f:14/24},{k:'9K',p:'375 · 37.5%',f:9/24}
];
const TOLA=11.6638, PAVAN=8;
function buildRateCard(){
  if(!spot.gold){toast('Waiting for the live gold rate — try again in a moment.');return null;}
  const g24=(spot.gold/OZ)*FX;                 // AED per gram, 24K basis
  const rows=RC_KARATS.map(x=>{const pg=g24*x.f;return{k:x.k,p:x.p,perG:pg,perPavan:pg*PAVAN,perTola:pg*TOLA};});
  const others=[];
  if(spot.silver){const s=(spot.silver/OZ)*FX;others.push({m:'Silver 999',v:s*0.999});others.push({m:'Silver 925',v:s*0.925});}
  if(spot.platinum)others.push({m:'Platinum 999',v:(spot.platinum/OZ)*FX*0.999});
  if(spot.palladium)others.push({m:'Palladium 999',v:(spot.palladium/OZ)*FX*0.999});
  if(copperUsdLb)others.push({m:'Copper (per kg)',v:(copperUsdLb/LB_G)*1000*FX});
  return {shopName:document.getElementById('rcShop').value.trim(),g24,goldUsdOz:spot.gold,rows,others};
}
function renderRateCardPDF_jsPDF(data){
  const {jsPDF}=window.jspdf;
  const doc=new jsPDF({unit:'mm',format:'a4'});
  const W=210,M=16,today=new Date();
  const gold=[201,162,39],dark=[26,22,14],gray=[120,120,120];
  doc.setFillColor(...gold);doc.rect(0,0,W,6,'F');
  let y=20;
  doc.setTextColor(...dark);doc.setFont('helvetica','bold');doc.setFontSize(21);
  doc.text(data.shopName||'GoldBench UAE',M,y);
  doc.setFont('helvetica','normal');doc.setFontSize(9);doc.setTextColor(...gray);
  doc.text('Daily precious-metals rate card  ·  GoldBench UAE',M,y+6);
  doc.setFont('helvetica','bold');doc.setFontSize(16);doc.setTextColor(...gold);
  doc.text('GOLD RATE CARD',W-M,y,{align:'right'});
  doc.setFont('helvetica','normal');doc.setFontSize(9);doc.setTextColor(90,90,90);
  doc.text(today.toLocaleDateString('en-GB'),W-M,y+6,{align:'right'});
  doc.text(today.toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'})+' (local)',W-M,y+11,{align:'right'});
  y+=20;
  doc.setDrawColor(220,215,205);doc.setLineWidth(0.4);doc.line(M,y,W-M,y);y+=7;
  doc.setFontSize(8.5);doc.setTextColor(...gray);
  doc.text(`Basis: 24K = ${fmt2(data.g24)} AED/g   ·   Gold spot $${fmt2(data.goldUsdOz)}/oz   ·   USD/AED ${FX}`,M,y);
  y+=8;
  // column anchors
  const cK=M+2, cP=M+22, xG=M+96, xPv=M+134, xTl=W-M-2;
  doc.setFillColor(26,22,14);doc.rect(M,y-4,W-2*M,9,'F');
  doc.setFont('helvetica','bold');doc.setFontSize(8.5);doc.setTextColor(230,190,90);
  doc.text('KARAT',cK,y+1.8);doc.text('PURITY',cP,y+1.8);
  doc.text('AED / g',xG,y+1.8,{align:'right'});
  doc.text('AED / Pavan (8g)',xPv,y+1.8,{align:'right'});
  doc.text('AED / Tola',xTl,y+1.8,{align:'right'});
  y+=9;
  data.rows.forEach((r,i)=>{
    if(i%2===0){doc.setFillColor(247,244,237);doc.rect(M,y-4.5,W-2*M,8,'F');}
    doc.setFont('helvetica','bold');doc.setFontSize(11);doc.setTextColor(...(r.k==='24K'?[176,140,45]:[40,40,40]));
    doc.text(r.k,cK,y+1);
    doc.setFont('helvetica','normal');doc.setFontSize(8.5);doc.setTextColor(120,120,120);
    doc.text(r.p,cP,y+1);
    doc.setFont('helvetica','bold');doc.setFontSize(10.5);doc.setTextColor(35,35,35);
    doc.text(fmt2(r.perG),xG,y+1,{align:'right'});
    doc.setFont('helvetica','normal');doc.setTextColor(70,70,70);
    doc.text(fmt2(r.perPavan),xPv,y+1,{align:'right'});
    doc.text(fmt2(r.perTola),xTl,y+1,{align:'right'});
    y+=8;
  });
  y+=4;
  if(data.others.length){
    doc.setFont('helvetica','bold');doc.setFontSize(9);doc.setTextColor(120,105,45);
    doc.text('OTHER METALS  ·  AED / gram',M,y);y+=6;
    doc.setDrawColor(230,226,216);doc.setLineWidth(0.2);
    const colW=(W-2*M)/2;
    data.others.forEach((o,i)=>{
      const col=i%2, row=Math.floor(i/2);
      const x=M+col*colW, yy=y+row*8;
      doc.setFont('helvetica','normal');doc.setFontSize(9.5);doc.setTextColor(70,70,70);
      doc.text(o.m,x+1,yy);
      doc.setFont('helvetica','bold');doc.setTextColor(35,35,35);
      doc.text(fmt2(o.v),x+colW-3,yy,{align:'right'});
    });
    y+=Math.ceil(data.others.length/2)*8+4;
  }
  doc.setDrawColor(220,215,205);doc.setLineWidth(0.3);doc.line(M,y,W-M,y);y+=6;
  doc.setFont('helvetica','normal');doc.setFontSize(7.5);doc.setTextColor(135,135,135);
  const note=[
    'Indicative live spot-based rates for information only — not a firm offer or tax invoice. Making charges, wastage and 5% VAT',
    '(where applicable; investment-grade 99%+ gold is zero-rated) are added separately at point of sale. Rates move continuously.',
    '1 Pavan = 8 g · 1 Tola = 11.6638 g. Verify against your dealer/shop board before transacting.'
  ];
  note.forEach((l,i)=>doc.text(l,M,y+i*4));
  y+=note.length*4+5;
  doc.setFontSize(8);doc.setTextColor(160,160,160);
  doc.text('Prepared with GoldBench UAE · idea & coded by Subash M · generated '+today.toLocaleString('en-GB'),M,y);
  const d=today,p=n=>String(n).padStart(2,'0');
  doc.save('GoldBench-Rate-Card-'+d.getFullYear()+p(d.getMonth()+1)+p(d.getDate())+'-'+p(d.getHours())+p(d.getMinutes())+'.pdf');
}
