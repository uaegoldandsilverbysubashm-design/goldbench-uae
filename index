}
function renderSessions(){
  const el=document.getElementById('sessGrid');
  if(!el)return;
  const nowUtcH=new Date().getUTCHours();
  el.innerHTML=SESSIONS_UTC.map(s=>{
    const active=s.startH<s.endH?(nowUtcH>=s.startH&&nowUtcH<s.endH):(nowUtcH>=s.startH||nowUtcH<s.endH);
    return `<div class="mi-card sess-card ${active?'active':''}"><div class="mi-lbl">${s.name}</div><div class="mi-val mn" style="font-size:14px">${utcHourToTzLabel(s.startH)}–${utcHourToTzLabel(s.endH)}</div><div class="mi-sub">${active?'Active now':'local time'}</div></div>`;
  }).join('');
}
function updateMarketStatus(){
  initTzSelect();
  const now=new Date();
  const state=mktState(now);
  const pill=document.getElementById('mktPill'),pt=document.getElementById('mktPillText');
  if(!pill)return;
