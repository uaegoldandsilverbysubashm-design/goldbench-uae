// ═══════════════════════════════════════════════════════════
const MKT_BREAK_START_H=21,MKT_BREAK_END_H=22; // UTC hour, daily
const SESSIONS_UTC=[
  {k:'sydney',name:'Sydney / Asia',startH:22,endH:7},
