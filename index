function mktWeeklyOpen(d){
  const day=d.getUTCDay(),hour=d.getUTCHours();
  if(day===6) return false;                 // Saturday: fully closed
  if(day===5 && hour>=22) return false;      // after Friday 22:00 UTC
  if(day===0 && hour<22) return false;       // before Sunday 22:00 UTC
  return true;
}
function mktDailyBreak(d){
  if(!mktWeeklyOpen(d)) return false;
  const h=d.getUTCHours();
  return h>=MKT_BREAK_START_H && h<MKT_BREAK_END_H;
}
function mktState(d){
  if(!mktWeeklyOpen(d)) return 'closed';
  if(mktDailyBreak(d)) return 'break';
  return 'open';
}
function mktNextTransition(now){
  const stepMs=5*60*1000;
  const startState=mktState(now);
  let cur=new Date(now.getTime());
  for(let i=0;i<9*24*12;i++){ // up to 9 days in 5-min steps
    cur=new Date(cur.getTime()+stepMs);
    if(mktState(cur)!==startState){
      // refine to the minute
      let refined=new Date(cur.getTime()-stepMs);
      for(let j=0;j<6;j++){
        const next=new Date(refined.getTime()+60000);
        if(mktState(next)===mktState(cur)){refined=next;break;}
        refined=next;
      }
      return {from:startState,to:mktState(cur),at:refined};
    }
  }
  return null;
}
function fmtCountdown(ms){
  if(ms<0)ms=0;
  const totalMin=Math.floor(ms/60000);
  const d=Math.floor(totalMin/1440),h=Math.floor((totalMin%1440)/60),m=totalMin%60;
  if(d>0) return `${d}d ${h}h`;
  if(h>0) return `${h}h ${m}m`;
  return `${m}m`;
}
function tzHM(date,tz){return date.toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit',hour12:false,timeZone:tz});}
function utcHourToTzLabel(h,tz,minAdd){
  const d=new Date();d.setUTCHours(h,minAdd||0,0,0);
  return tzHM(d,tz||selectedTz);
}
// Weekday name ("Mon".."Sun") as it currently reads in a given tz — using
// a forward toLocaleString conversion (always correct for any offset or
// DST) rather than reverse-engineering UTC from a local wall-clock time.
function tzWeekdayName(tz,date){return (date||new Date()).toLocaleString('en-US',{timeZone:tz,weekday:'short'});}
const THD_DAYS=['Mon','Tue','Wed','Thu','Fri'];
// The weekly-closed window is Fri 22:00 UTC through Sun 22:00 UTC. Across
// every real-world UTC offset (-12..+14) that never eats into Monday or
// Friday's local trading time, so — regardless of the selected timezone —
// Mon-Fri always share the same "one daily break, otherwise open" shape;
// only the break's local clock time (and which weekday currently reads as
// "today") changes with the timezone picker.
function renderTradingHoursGrid(){
  const el=document.getElementById('thdGrid');
  if(!el)return;
  const breakStart=utcHourToTzLabel(MKT_BREAK_START_H),breakEnd=utcHourToTzLabel(MKT_BREAK_END_H);
