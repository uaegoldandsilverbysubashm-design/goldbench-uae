async function fetchAll(isRetry){
  const btn=document.getElementById('rb');
  btn.classList.add('ld');btn.disabled=true;
  if(!isRetry) setLivePill('live','...');
  if(retryTimer){clearTimeout(retryTimer);retryTimer=null;}
  const metals=['gold','silver','platinum','palladium'];
  const [results,copperResult]=await Promise.all([
    Promise.all(metals.map(m=>fetchMetal(m))),
    fetchCopper()
  ]);
  updCopper(copperResult);
  let anySuccess=false;
  metals.forEach((m,i)=>{
    const data=results[i];
    if(data){
      anySuccess=true;
      spot[m]=data.mid;
      metalData[m]=data;
      lastGoodAt[m]=Date.now();
      lastSource[m]=data.source;
    }
  });
  updOz('gold','oG','ouG','odG','srcG',results[0]);
  updOz('silver','oS','ouS','odS','srcS',results[1]);
  updOz('platinum','oP','ouP','odP','srcP',results[2]);
  updOz('palladium','oD','ouD','odD','srcD',results[3]);
  if(anySuccess){
    consecutiveFailures=0;
    render();calcRate();updateQS();updateIndicators();renderQuotesFallback();
    if(typeof hOnSpot==='function')hOnSpot();
    checkStaleness();
    dismissBanner();
    document.getElementById('atText').textContent='auto 30s';
    retryTimer=setTimeout(()=>fetchAll(true),30000);
  }else{
    consecutiveFailures++;
    checkStaleness();
    showBanner('Live price feed unreachable (network blocked or all sources down). Showing last known prices'+(lastGoodAt.gold?' from '+fmtAgo(Date.now()-lastGoodAt.gold):'')+'. Will keep retrying automatically.');
    // back off faster retries on failure instead of waiting the full 30s
    const retryIn=Math.min(10000*Math.pow(1.5,Math.min(consecutiveFailures,5)),30000);
    document.getElementById('atText').textContent='retrying in '+Math.round(retryIn/1000)+'s';
    retryTimer=setTimeout(()=>fetchAll(true),retryIn);
  }
  btn.classList.remove('ld');btn.disabled=false;
  document.getElementById('tsUp').textContent=new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false,timeZone:'Asia/Dubai'});
}
