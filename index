function calcRate(){
  const m=document.getElementById('cMetal').value;
  const pIdx=parseInt(document.getElementById('cPurity').value)||0;
  const weight=parseFloat(document.getElementById('cWeight').value)||0;
  const mkType=document.getElementById('cMkType').value;
  const mkVal=parseFloat(document.getElementById('cMkVal').value)||0;
  const discType=document.getElementById('cDiscType').value;
  const discVal=parseFloat(document.getElementById('cDiscVal').value)||0;
  const purity=CALC_PURITIES[m][pIdx];
  if(!spot[m]||!weight||!purity){['crMetal','crMaking','crDisc','crSub','crVat','crTotal'].forEach(id=>document.getElementById(id).textContent='-');return;}
  const ppg=(spot[m]/OZ)*FX*purity.f;
  const metalVal=ppg*weight;
  let making=0;
  if(mkType==='per_gram') making=mkVal*weight;
  else if(mkType==='total') making=mkVal;
  else if(mkType==='percent') making=metalVal*(mkVal/100);
  const beforeDiscount=metalVal+making;
  let discount=0;
  if(discType==='flat') discount=discVal;
  else if(discType==='percent') discount=beforeDiscount*(discVal/100);
  else if(discType==='per_gram') discount=discVal*weight;
  if(discount>beforeDiscount) discount=beforeDiscount;
  const subtotal=beforeDiscount-discount;
  const isInvestment=purity.inv;
  const vatRate=isInvestment?0:0.05;
  const vat=subtotal*vatRate;
  const total=subtotal+vat;
  document.getElementById('crMetal').textContent=`${fm(metalVal)} AED`;
  document.getElementById('crMaking').textContent=`${fm(making)} AED`;
  const discLabel=document.getElementById('crDiscLabel');
  const discDisplay=document.getElementById('crDisc');
  if(discount>0){discLabel.textContent=discType==='percent'?`Discount (${discVal}%)`:'Discount';discDisplay.textContent=`- ${fm(discount)} AED`;}
  else{discLabel.textContent='Discount';discDisplay.textContent='0.00 AED';}
  document.getElementById('crSub').textContent=`${fm(subtotal)} AED`;
  const vatLabel=document.getElementById('crVatLabel');
  const vatVal=document.getElementById('crVat');
  if(isInvestment){vatLabel.textContent='VAT 0% (Investment Grade 99%+)';vatLabel.style.color='var(--gn)';vatVal.textContent='0.00 AED';vatVal.style.color='var(--gn)';}
  else{vatLabel.textContent='VAT 5% (Retail/Jewellery)';vatLabel.style.color='var(--rd)';vatVal.textContent=`${fm(vat)} AED`;vatVal.style.color='var(--rd)';}
  document.getElementById('crTotal').textContent=`${fm(total)} AED`;
}
