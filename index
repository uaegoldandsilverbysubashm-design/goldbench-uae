  gold:[{l:'24K (999)',f:1,inv:true},{l:'22K',f:22/24,inv:false},{l:'21K',f:21/24,inv:false},{l:'18K',f:18/24,inv:false},{l:'14K',f:14/24,inv:false},{l:'9K',f:9/24,inv:false}],
