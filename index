// LIVE DATA: multi-source fetch with fallback + staleness tracking
// Primary: Swissquote bank feed (has real bid/ask) via CORS proxies.
// Fallback: gold-api.com (CORS-enabled directly, no proxy, no key,
//           but single mid price only — spread is synthesized).
// ═══════════════════════════════════════════════════════════
const SQ_SYM={gold:'XAU',silver:'XAG',platinum:'XPT',palladium:'XPD'};
const GA_SYM={gold:'XAU',silver:'XAG',platinum:'XPT',palladium:'XPD'};
// Typical bid/ask spreads (USD/oz) used only to synthesize a display
// spread when the fallback source gives us a single mid price.
const TYPICAL_SPREAD={gold:1.0,silver:0.04,platinum:6,palladium:10};
let lastGoodAt={gold:0,silver:0,platinum:0,palladium:0};
let lastSource={gold:null,silver:null,platinum:null,palladium:null};
let consecutiveFailures=0;
const STALE_MS=90*1000;     // amber warning threshold
const DEAD_MS=5*60*1000;    // treat as fully offline after this long
function withTimeout(promise,ms){
  return Promise.race([
    promise,
    new Promise((_,rej)=>setTimeout(()=>rej(new Error('timeout')),ms))
  ]);
}
async function tryDirect(url){
  const r=await withTimeout(fetch(url,{mode:'cors',cache:'no-store'}),7000);
  if(!r.ok) throw new Error('http '+r.status);
  return await r.text();
}
async function tryProxy(proxyBuilder,url){
  const r=await withTimeout(fetch(proxyBuilder(url),{cache:'no-store'}),8000);
  if(!r.ok) throw new Error('http '+r.status);
  return await r.text();
}
// Ordered list of ways to reach an arbitrary URL cross-origin.
const PROXIES=[
  url=>url, // direct attempt first (works if target sends permissive CORS, or via browser extensions)
  url=>`https://corsproxy.io/?url=${encodeURIComponent(url)}`,
  url=>`https://api.allorigins.win/raw?url=${encodeURIComponent(url)}`,
  url=>`https://api.codetabs.com/v1/proxy?quest=${encodeURIComponent(url)}`,
];
async function fetchViaProxies(url){
  let lastErr=null;
  for(const build of PROXIES){
    try{
      const text=await tryProxy(build,url);
      if(text) return text;
    }catch(e){lastErr=e;}
  }
  throw lastErr||new Error('all proxies failed');
}
async function fetchSwissquote(metal){
  const sym=SQ_SYM[metal];
  const url=`https://forex-data-feed.swissquote.com/public-quotes/bboquotes/instrument/${sym}/USD`;
  const raw=await fetchViaProxies(url);
  const j=JSON.parse(raw);
  const p=j?.[0]?.spreadProfilePrices?.[0];
  if(!p||typeof p.bid!=='number'||typeof p.ask!=='number') throw new Error('bad shape');
  return{bid:p.bid,ask:p.ask,mid:+(((p.bid+p.ask)/2).toFixed(4)),source:'Swissquote'};
}
async function fetchGoldApi(metal){
  const sym=GA_SYM[metal];
  // gold-api.com has CORS enabled directly — no proxy needed.
  const text=await tryDirect(`https://api.gold-api.com/price/${sym}`);
  const j=JSON.parse(text);
  const mid=j?.price;
  if(typeof mid!=='number'||!isFinite(mid)||mid<=0) throw new Error('bad shape');
  const half=TYPICAL_SPREAD[metal]/2;
  return{bid:+(mid-half).toFixed(4),ask:+(mid+half).toFixed(4),mid:+mid.toFixed(4),source:'gold-api.com (est. spread)'};
}
async function fetchMetal(metal){
  // Try primary first, then fallback. Either can win.
  try{
    return await fetchSwissquote(metal);
  }catch(e1){
    try{
      return await fetchGoldApi(metal);
    }catch(e2){
      return null;
    }
  }
}
// ═══ COPPER (base metal reference) ═══
// gold-api.com is the only free, no-key source among the ones this app
// already trusts that also carries copper (symbol HG, COMEX, USD/lb) —
// Swissquote's feed only covers XAU/XAG/XPT/XPD, and there's no free
// live source for rhodium, so copper is the one extra metal that can
// actually be added here without faking a price. It's priced per pound,
// not per troy ounce, so it gets its own small fetch/render path rather
// than being forced through the OZ-based fetchMetal()/updOz() pipeline.
const LB_G=453.59237;
let copperUsdLb=0,copperLastGoodAt=0,copperSource=null;
async function fetchCopper(){
  try{
    const text=await tryDirect('https://api.gold-api.com/price/HG');
    const j=JSON.parse(text);
    const usdPerLb=j?.price;
    if(typeof usdPerLb!=='number'||!isFinite(usdPerLb)||usdPerLb<=0) throw new Error('bad shape');
    return{usdPerLb,source:'gold-api.com'};
  }catch(e){return null;}
}
function updCopper(data){
  const el=document.getElementById('oCu');
  if(!el)return;
  if(!data){
    if(!copperUsdLb){el.innerHTML='<span class="errd">No data yet</span>';document.getElementById('ouCu').textContent='-';document.getElementById('odCu').textContent='Waiting for first successful fetch...';}
    return;
  }
  copperUsdLb=data.usdPerLb;copperLastGoodAt=Date.now();copperSource=data.source;
  const usdPerGram=data.usdPerLb/LB_G;
  const aedPerKg=usdPerGram*1000*FX,aedPerG=usdPerGram*FX;
