// Gather a clean, self-consistent quote object from the Rate Calculator.
function buildRateQuote(){
  const m=document.getElementById('cMetal').value;
  const pIdx=parseInt(document.getElementById('cPurity').value)||0;
  const weight=parseFloat(document.getElementById('cWeight').value)||0;
  const mkType=document.getElementById('cMkType').value;
  const mkVal=parseFloat(document.getElementById('cMkVal').value)||0;
  const discType=document.getElementById('cDiscType').value;
  const discVal=parseFloat(document.getElementById('cDiscVal').value)||0;
  const purity=CALC_PURITIES[m][pIdx];
  if(!spot[m]||!weight||!purity){toast('Enter a weight and wait for the live rate before downloading.');return null;}
  const ppg=(spot[m]/OZ)*FX*purity.f;
  const metalVal=ppg*weight;
  let making=0,mkDesc='';
  if(mkType==='per_gram'){making=mkVal*weight;mkDesc=`${fmt2(mkVal)} AED/g × ${weight}g`;}
  else if(mkType==='total'){making=mkVal;mkDesc='flat';}
  else if(mkType==='percent'){making=metalVal*(mkVal/100);mkDesc=`${mkVal}% of metal`;}
  const beforeDiscount=metalVal+making;
  let discount=0,discDesc='';
  if(discType==='flat'){discount=discVal;}
  else if(discType==='percent'){discount=beforeDiscount*(discVal/100);discDesc=`${discVal}%`;}
  else if(discType==='per_gram'){discount=discVal*weight;discDesc=`${fmt2(discVal)} AED/g`;}
  if(discount>beforeDiscount)discount=beforeDiscount;
  const subtotal=beforeDiscount-discount;
  const isInv=!!purity.inv,vat=subtotal*(isInv?0:0.05),total=subtotal+vat;
  const items=[{label:`${METAL_NAME[m]} ${purity.l} — ${weight} g @ ${fmt2(ppg)} AED/g`,amount:metalVal}];
  if(making>0)items.push({label:`Making Charge (${mkDesc})`,amount:making});
  return {
    customerName:document.getElementById('qcRate').value.trim(),
    shopName:document.getElementById('qsRate').value.trim(),
    rateLine:`Live ${METAL_NAME[m]} rate: ${fmt2((spot[m]/OZ)*FX)} AED/g (24K basis)  ·  purity ${purity.l}`,
    items,subtotal,
    discount,discountLabel:discount>0?('Discount'+(discDesc?' ('+discDesc+')':'')):'',
    vat,vatLabel:isInv?'VAT 0% (Investment grade 99%+)':'VAT 5% (Retail / Jewellery)',
    total
  };
}
